# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# --- Supabase Postgres ---
DATABASE_URL=jdbc:postgresql://localhost:5432/coursecraft
DATABASE_USER=coursecraft
DATABASE_PASSWORD=coursecraft

# --- Supabase Auth (verify JWTs) ---
# From your Supabase project settings:
SUPABASE_JWKS_URI=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_ALGORITHMS=RS256,ES256

PORT=8080
