# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# --- Supabase Postgres ---
# Direct connection (IPv6-only on the free tier — fine for local dev on an IPv6 network):
DATABASE_URL=jdbc:postgresql://db.qvpaeptwdplpflbxpwav.supabase.co:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR_DB_PASSWORD
#
# For Render (IPv4-only) or any IPv4 network, use the Session pooler instead — from the
# Supabase "Connect" dialog → Session pooler tab (host aws-0-<region>.pooler.supabase.com):
#   DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
#   DATABASE_USER=postgres.qvpaeptwdplpflbxpwav
# (If you ever use the Transaction pooler on port 6543, append ?prepareThreshold=0 to the URL.)

# --- Supabase Auth (verify JWTs) ---
# Project ref qvpaeptwdplpflbxpwav (public — appears in every API/JWKS URL, not a secret).
# NOTE: these only return keys once you've enabled an asymmetric signing key:
#   Supabase dashboard → Settings → JWT → "Migrate JWT secret" then "Rotate keys".
SUPABASE_JWKS_URI=https://qvpaeptwdplpflbxpwav.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://qvpaeptwdplpflbxpwav.supabase.co/auth/v1
SUPABASE_JWT_ALGORITHMS=RS256,ES256

PORT=8080
